{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "devflow/schemas/self-check.schema.json",
  "title": "devflow P3 完成度自检结构化产物（self-check.json）",
  "description": "P3（及任意 Phase 切换前）完成度自检的机器可读业务产物层。检查矩阵由 completeness-auditor 独立产出；汇总计数由渲染器派生；校验器强制核心检查项全 PASS（FAIL 即阻塞进入下个 Phase）、PASS 行必须留实测结果、命令输出附件必须实质。",
  "type": "object",
  "x-unique": ["checks[].id"],
  "x-zeroable": ["unfixed"],
  "required": ["feature", "generated_at", "template", "feature_name", "phase", "phase_name", "executor", "executed_at", "checks", "unfixed", "conclusion", "outputs", "signoffs", "zero_results"],
  "additionalProperties": false,
  "properties": {
    "feature": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 },
    "template": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "const": "完成度自检报告-模板" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "feature_name": { "type": "string", "minLength": 1 },
    "phase": { "type": "string", "pattern": "^P[0-9]+[a-z]?$" },
    "phase_name": { "type": "string", "minLength": 1 },
    "executor": { "type": "string", "minLength": 1, "description": "completeness-auditor（与开发角色分离）" },
    "executed_at": { "type": "string", "minLength": 1 },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "category", "item", "cmd", "expected", "actual", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^C-[0-9]{1,3}$" },
          "category": { "enum": ["core", "module"], "description": "core=核心检查项（必须全过）；module=模块专项" },
          "item": { "type": "string", "minLength": 2 },
          "cmd": { "type": "string", "minLength": 4, "description": "检查命令（真实可执行）" },
          "expected": { "type": "string", "minLength": 1 },
          "actual": { "type": "string", "description": "实测结果；PASS 时必填（跨字段校验）" },
          "status": { "enum": ["PASS", "FAIL"] }
        }
      }
    },
    "unfixed": {
      "type": "array",
      "description": "未修复 P1/P2 清单（不阻塞本 Phase 但必须登记）",
      "items": {
        "type": "object",
        "required": ["severity", "description", "scope", "owner", "eta"],
        "additionalProperties": false,
        "properties": {
          "severity": { "enum": ["P1", "P2"] },
          "description": { "type": "string", "minLength": 4 },
          "scope": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "eta": { "type": "string", "minLength": 1 }
        }
      }
    },
    "conclusion": { "enum": ["PASS", "FAIL"], "description": "core 全 PASS 才能为 PASS（跨字段校验，FAIL 即管线拒绝）" },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "description": "命令输出附件（粘贴实际输出，禁止只写「已验证」）",
      "items": {
        "type": "object",
        "required": ["check_id", "output"],
        "additionalProperties": false,
        "properties": {
          "check_id": { "type": "string", "pattern": "^C-[0-9]{1,3}$" },
          "output": { "type": "string", "minLength": 8, "description": "实际命令输出（跨字段校验长度下限）" }
        }
      }
    },
    "signoffs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "name", "date"],
        "additionalProperties": false,
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "date": { "type": "string", "minLength": 1 }
        }
      }
    },
    "zero_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "reason"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
