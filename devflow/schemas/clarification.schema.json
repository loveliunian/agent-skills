{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://devflow.local/schemas/clarification.schema.json",
  "title": "P0 需求澄清结构化产物 (v3.27.15)",
  "description": "P0 阶段输出的需求澄清结构化产物，包含实体、操作、约束提取",
  "type": "object",
  "required": [
    "feature_name",
    "prd_path",
    "acceptance_points",
    "entities",
    "operations",
    "constraints",
    "deep_probes"
  ],
  "properties": {
    "feature_name": {
      "type": "string",
      "minLength": 1,
      "description": "功能名称"
    },
    "prd_path": {
      "type": "string",
      "minLength": 1,
      "description": "PRD 文档路径"
    },
    "clarified_at": {
      "type": "string",
      "format": "date-time",
      "description": "澄清完成时间 (ISO8601)"
    },
    "acceptance_points": {
      "type": "array",
      "minItems": 1,
      "description": "原子验收点列表",
      "items": {
        "type": "object"
      }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "description": "业务实体列表（至少 1 个）",
      "items": {
        "type": "object"
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "description": "业务操作列表（至少 1 个）",
      "items": {
        "type": "object"
      }
    },
    "constraints": {
      "type": "array",
      "description": "业务约束列表（可为空数组，但必须显式声明）",
      "items": {
        "type": "object"
      }
    },
    "clarifications": {
      "type": "array",
      "description": "需求澄清记录",
      "items": {
        "type": "object",
        "required": [
          "question",
          "answer"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "answer": {
            "type": "string",
            "minLength": 1
          },
          "stakeholder": {
            "type": "string",
            "description": "回答者角色"
          }
        }
      }
    },
    "out_of_scope": {
      "type": "array",
      "description": "不在本期范围内的需求",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assumptions": {
      "type": "array",
      "description": "假设条件",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risks": {
      "type": "array",
      "description": "风险点",
      "items": {
        "type": "object",
        "required": [
          "description",
          "severity",
          "mitigation"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "高",
              "中",
              "低"
            ]
          },
          "mitigation": {
            "type": "string",
            "minLength": 1,
            "description": "缓解措施"
          }
        }
      }
    },
    "deep_probes": {
      "type": "array",
      "description": "深挖探针（v3.27.15）：在拆分验收点之前，系统性地检查 PRD 的逻辑一致性、状态完整性、数据流闭环、并发冲突、失败链路、隐含假设、权限边界、验收完备性——发现的问题写入澄清记录待确认",
      "items": {
        "type": "object",
        "required": [
          "probe",
          "status",
          "findings"
        ],
        "properties": {
          "probe": {
            "type": "string",
            "enum": [
              "logical_consistency",
              "state_completeness",
              "data_flow_closure",
              "concurrency_conflict",
              "failure_chain",
              "implicit_assumption",
              "permission_boundary",
              "acceptance_testability"
            ],
            "description": "探针类型：逻辑矛盾/状态完整性/数据流闭环/并发冲突/失败链路/隐含假设/权限边界/验收完备性"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "findings",
              "not_applicable"
            ],
            "description": "pass=未发现问题；findings=发现待确认问题；not_applicable=不适用（须给理由）"
          },
          "findings": {
            "type": "array",
            "description": "发现的问题清单（status=findings 时必填 ≥1 条；pass/not_applicable 可为空）",
            "items": {
              "type": "object"
            }
          },
          "not_applicable_reason": {
            "type": "string",
            "description": "status=not_applicable 时必填"
          }
        }
      }
    },
    "feature": {
      "type": "string",
      "description": "feature 标识"
    },
    "generated_at": {
      "type": "string",
      "description": "生成时间"
    },
    "template": {
      "type": "object",
      "description": "模板身份"
    },
    "date": {
      "type": "string",
      "description": "澄清日期"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "参与者"
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "模糊点清单"
    },
    "conclusion": {
      "type": [
        "string",
        "object"
      ],
      "description": "澄清结论（字符串摘要或含子项的对象）"
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "排除项"
    },
    "exclusions_covered": {
      "type": "boolean",
      "description": "排除项已覆盖"
    },
    "permission_scope": {
      "type": "string",
      "description": "权限范围"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "object"
        ]
      },
      "description": "权限清单（字符串或对象均可）"
    },
    "followups": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "待确认事项"
    },
    "signoffs": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "签字确认"
    },
    "zero_results": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "零结果声明"
    }
  },
  "x-zeroable": [
    "followups",
    "exclusions"
  ]
}