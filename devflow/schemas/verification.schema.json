{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "devflow/schemas/verification.schema.json",
  "title": "devflow P6 终验结构化核心（verification.json）",
  "description": "P6 部署前终验的机器可读业务产物层。验收点集合必须与 P4 冻结 baseline 全等；五类测试证据绑定命令、退出码、报告路径与 SHA-256（校验器实算哈希，不信任手写值）；Gate（s6_final_verification_gate.sh）仍是执行权威——本 JSON 的声明退出码须与 Gate 实际执行退出码一致（--exec-record 对账）。零结果/不适用必须显式声明，静默省略即校验拦截。",
  "type": "object",
  "required": ["feature", "generated_at", "environment", "acceptance_results", "evidence", "client_not_applicable", "zero_results"],
  "additionalProperties": false,
  "properties": {
    "feature": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1, "description": "ISO8601 时间戳" },
    "environment": { "enum": ["dev", "staging", "production"] },
    "acceptance_results": {
      "type": "array",
      "minItems": 1,
      "description": "每冻结验收点恰好一行终态；集合与 baseline 全等（跨字段校验）",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^M-?[0-9]{2}-F[0-9]{2}-A[0-9]{2}$" },
          "status": { "enum": ["PASS", "FAIL", "BLOCKED"], "description": "终验放行要求全 PASS（跨字段校验 FAIL=0）" },
          "evidence": { "type": "string", "description": "该点证据位置（报告锚点/命令输出文件）" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "description": "五类测试证据；unit/integration/load/staging 必填，client 受 client_not_applicable 约束",
      "required": ["unit", "integration", "load", "staging"],
      "additionalProperties": false,
      "properties": {
        "unit": { "$ref": "#/definitions/evidence_obj" },
        "integration": { "$ref": "#/definitions/evidence_obj" },
        "client": { "$ref": "#/definitions/evidence_obj" },
        "load": { "$ref": "#/definitions/evidence_obj" },
        "staging": { "$ref": "#/definitions/evidence_obj" }
      }
    },
    "client_not_applicable": {
      "type": "object",
      "description": "客户端范围声明——与启动冻结的 --frontend 一致；声明 true 时 evidence.client 必须缺省且 frontend_scope=not-applicable。Gate 侧对应 test-evidence.env 的 CLIENT_EXEMPT=1（两层声明双向一致，矛盾即校验拦截）",
      "required": ["declared", "frontend_scope"],
      "additionalProperties": false,
      "properties": {
        "declared": { "type": "boolean" },
        "frontend_scope": { "enum": ["pc-web", "mini-program", "app", "not-applicable"] },
        "reason": { "type": "string", "description": "declared=true 时必填（跨字段校验）" }
      }
    },
    "zero_results": {
      "type": "array",
      "description": "零结果声明（如某类测试用例数为 0 的合法场景）；渲染器生成显式话术",
      "items": {
        "type": "object",
        "required": ["path", "reason"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "definitions": {
    "evidence_obj": {
      "type": "object",
      "required": ["cmd", "exit_code", "report_path"],
      "additionalProperties": false,
      "properties": {
        "cmd": { "type": "string", "minLength": 1, "description": "实际测试命令（占位命令 true/echo/ls/: 等及 shell 转包被校验器拒绝；提供 --exec-record 时必须与 Gate 执行记录的 KIND_CMD 逐字一致）" },
        "exit_code": { "type": "integer", "description": "声明退出码；须=0 且与 Gate 实际执行退出码一致" },
        "report_path": { "type": "string", "minLength": 1, "description": "本轮命令生成的报告文件" },
        "report_sha256": { "type": "string", "description": "可选断言；提供时校验器实算比对" },
        "log_path": { "type": "string", "description": "可选执行日志" }
      }
    }
  }
}
