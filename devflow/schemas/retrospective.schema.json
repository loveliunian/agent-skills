{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "devflow/schemas/retrospective.schema.json",
  "title": "devflow P10 复盘结构化产物（retrospective.json）",
  "description": "P10 复盘的机器可读业务产物层（只写四件事：复盘事实→根因→行动→反馈队列）。每行阶段合规事实必须附真实收据路径（禁止无证据自评）；反馈队列保持项目本地（scope=project）；复核命令实际输出必须粘贴。渲染器派生阶段事实表与 FEEDBACK 契约块（p10_feedback_gate.sh 词汇表兼容）。",
  "type": "object",
  "x-zeroable": ["facts", "misses", "new_findings"],
  "required": ["feature", "generated_at", "template", "feature_name", "date", "participants", "period", "phase_facts", "facts", "misses", "new_findings", "actions", "feedback", "verify_output", "zero_results"],
  "additionalProperties": false,
  "properties": {
    "feature": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 },
    "template": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "const": "复盘报告-模板" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "feature_name": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "minLength": 1 },
    "participants": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "period": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 }
      }
    },
    "phase_facts": {
      "type": "array",
      "minItems": 1,
      "description": "阶段合规事实；收据路径必须真实存在（跨字段校验）",
      "items": {
        "type": "object",
        "required": ["phase", "gate_result", "receipt_path", "skip_note"],
        "additionalProperties": false,
        "properties": {
          "phase": { "type": "string", "pattern": "^P[0-9]+[a-z]?(~P[0-9]+[a-z]?)?$" },
          "gate_result": { "enum": ["PASS", "BLOCKED", "SKIPPED"] },
          "receipt_path": { "type": "string", "minLength": 1, "description": ".devflow/<feature>/gates/ 或 docs/<feature>/gates/ 下的收据路径" },
          "skip_note": { "type": "string", "description": "SKIPPED 时必填 skip-log 授权说明（跨字段校验）" }
        }
      }
    },
    "facts": {
      "type": "array",
      "description": "复盘事实与根因（没有就删掉本节——zero_results 声明）",
      "items": {
        "type": "object",
        "required": ["title", "what", "why", "why_missed", "impact", "owner", "eta"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 2 },
          "what": { "type": "string", "minLength": 4, "description": "发生了什么" },
          "why": { "type": "string", "minLength": 4, "description": "为什么会发生" },
          "why_missed": { "type": "string", "minLength": 4, "description": "为什么会漏掉" },
          "impact": { "type": "string", "minLength": 2 },
          "owner": { "type": "string", "minLength": 1 },
          "eta": { "type": "string", "minLength": 1 }
        }
      }
    },
    "misses": {
      "type": "array",
      "description": "上次遗漏了什么",
      "items": {
        "type": "object",
        "required": ["item", "impact", "fix"],
        "additionalProperties": false,
        "properties": {
          "item": { "type": "string", "minLength": 2 },
          "impact": { "type": "string", "minLength": 2 },
          "fix": { "type": "string", "minLength": 2 }
        }
      }
    },
    "new_findings": {
      "type": "array",
      "description": "本次新发现（p10 Gate 强制章节；确无新发现须 zero_results 声明）",
      "items": {
        "type": "object",
        "required": ["item", "impact", "fix"],
        "additionalProperties": false,
        "properties": {
          "item": { "type": "string", "minLength": 2 },
          "impact": { "type": "string", "minLength": 2 },
          "fix": { "type": "string", "minLength": 2 }
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "description": "行动计划（复盘必须产出可执行改进项）",
      "items": {
        "type": "object",
        "required": ["item", "priority", "owner", "eta"],
        "additionalProperties": false,
        "properties": {
          "item": { "type": "string", "minLength": 2 },
          "priority": { "enum": ["P0", "P1", "P2"] },
          "owner": { "type": "string", "minLength": 1 },
          "eta": { "type": "string", "minLength": 1 }
        }
      }
    },
    "feedback": {
      "type": "object",
      "description": "反馈队列（P10 硬闭环；经 --out-feedback 渲染为 .devflow/<feature>/feedback/feedback.md，字段与 p10_feedback_gate.sh 逐字段一致）",
      "required": ["feedback_id", "scope", "status", "skill_modify_approved", "root_cause", "target_files", "decision"],
      "additionalProperties": false,
      "properties": {
        "feedback_id": { "type": "string", "pattern": "^FB-[0-9]{8}-[0-9]{3}$" },
        "scope": { "enum": ["project"], "description": "反馈队列保持项目本地，不外传" },
        "status": { "enum": ["PROPOSED", "ACCEPTED"] },
        "skill_modify_approved": { "type": "boolean", "description": "修改已安装 skill 必须用户明确批准（原则 9）；未批准不得 apply" },
        "root_cause": { "type": "string", "minLength": 4, "description": "根因记录（ROOT_CAUSE，Gate 必填）" },
        "target_files": {
          "type": "array",
          "minItems": 1,
          "description": "整改目标文件（TARGET_FILES，逗号列表）",
          "items": { "type": "string", "minLength": 1 }
        },
        "decision": { "enum": ["fix", "defer"], "description": "处理决定（DECISION）" },
        "defer_reason": { "type": "string", "description": "decision=defer 时必填（跨字段校验）" }
      }
    },
    "verify_output": { "type": "string", "minLength": 20, "description": "复核命令（收据清点/反馈队列检查/p10 gate）的实际输出粘贴" },
    "zero_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "reason"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
