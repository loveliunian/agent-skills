{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "devflow/schemas/acceptance.schema.json",
  "title": "devflow P0 原子验收点清单结构化产物（acceptance.json）",
  "description": "P0 验收点清单（冻结分母）的机器可读业务产物层。渲染器按功能号分组派生清单表与「分母已冻结」行（s0_acceptance_gate.sh §1/§4/§5 的机械解析格式）；校验器强制全部 FROZEN + PRD 来源真实存在。验收点 ID 是后续 P2/P5/P6 的集合全等基准，本 JSON 即冻结分母的唯一正本。",
  "type": "object",
  "x-unique": ["points[].id"],
  "required": ["feature", "generated_at", "template", "feature_name", "module", "prd_doc", "date", "splitter", "points", "reviews", "signoffs", "zero_results"],
  "additionalProperties": false,
  "properties": {
    "feature": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 },
    "template": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "const": "验收点-模板" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "feature_name": { "type": "string", "minLength": 1 },
    "module": { "type": "string", "pattern": "^[0-9]{2}$", "description": "模块编码两位数字（M-{xx}）" },
    "prd_doc": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "minLength": 1 },
    "splitter": { "type": "string", "minLength": 1, "description": "拆分人" },
    "points": {
      "type": "array",
      "minItems": 1,
      "description": "原子验收点；全部 FROZEN 后才能进 P2（跨字段校验）",
      "items": {
        "type": "object",
        "required": ["id", "description", "verify_method", "prd_anchor", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^M-[0-9]{2}-F[0-9]{2}-A[0-9]{2}$", "description": "原子验收点 ID（一个验收点 = 一个行为 = 一个测试用例）；必须带连字符规范形——s0/p5 Gate 的 M-ID 正则只认 M-xx-Fyy-Azz，无连字符形态会被判 invalid" },
          "feature_label": { "type": "string", "description": "所属功能名称（渲染分组标题用，同一 F 号只需一致）" },
          "description": { "type": "string", "minLength": 4, "description": "行为描述（可观察、可验证、可失败）" },
          "verify_method": { "enum": ["API", "UI", "单元测试"], "description": "验证方式" },
          "prd_anchor": { "type": "string", "pattern": "^\\S+#[^#\\s]+$", "description": "PRD 原文锚点（文件#行号/章节），来源文件必须真实存在（跨字段校验）" },
          "status": { "enum": ["DRAFT", "REVIEWING", "FROZEN"] }
        }
      }
    },
    "reviews": {
      "type": "array",
      "description": "评审记录",
      "items": {
        "type": "object",
        "required": ["round", "reviewer", "date", "verdict", "leftovers"],
        "additionalProperties": false,
        "properties": {
          "round": { "type": "integer" },
          "reviewer": { "type": "string", "minLength": 1 },
          "date": { "type": "string", "minLength": 1 },
          "verdict": { "type": "string", "minLength": 1 },
          "leftovers": { "type": "string" }
        }
      }
    },
    "signoffs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "name", "date"],
        "additionalProperties": false,
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "date": { "type": "string", "minLength": 1 }
        }
      }
    },
    "zero_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "reason"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
