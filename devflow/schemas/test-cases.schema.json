{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "devflow/schemas/test-cases.schema.json",
  "title": "devflow P5 测试用例结构化产物（test-cases.json）",
  "description": "P5 测试用例的机器可读业务产物层。用例数 ≥ 详设；每条用例必须有前置条件与步骤；验收点全覆盖（--criteria 冻结分母对账）；边界/异常用例 ≥1；凭证必须从 seed/配置事实源追溯（铁律 6）。渲染器派生用例清单表（p5_test_cases_gate.sh 逐行解析 | TC- 开头表格行，格式逐字段兼容）与结果汇总。",
  "type": "object",
  "x-unique": ["cases[].id"],
  "x-refs": [
    { "from": "defects[].case_id", "to": "cases[].id", "label": "缺陷→用例" }
  ],
  "x-zeroable": ["defects"],
  "required": ["feature", "generated_at", "template", "feature_name", "module", "author", "date", "version", "credentials", "cases", "defects", "signoffs", "zero_results"],
  "additionalProperties": false,
  "properties": {
    "feature": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 },
    "template": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "const": "测试用例-模板" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "feature_name": { "type": "string", "minLength": 1 },
    "module": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1, "description": "用例版本（v1.0）" },
    "credentials": {
      "type": "array",
      "minItems": 1,
      "description": "测试凭证来源表；每项必须给代码来源文件与行号（铁律 6）",
      "items": {
        "type": "object",
        "required": ["item", "value_ref", "source_file", "line"],
        "additionalProperties": false,
        "properties": {
          "item": { "type": "string", "minLength": 1, "description": "用户名/密码/E2E helper…" },
          "value_ref": { "type": "string", "minLength": 1, "description": "值或受控引用（密码写 seed 读取方式，不写明文）" },
          "source_file": { "type": "string", "minLength": 1, "description": "seed/初始化器的准确路径" },
          "line": { "type": "string", "minLength": 1, "description": "行号" }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "priority", "type", "acceptance_refs", "precondition", "steps", "result"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^TC-[A-Za-z0-9._-]+$", "description": "用例编号（TC-{feature}-001）" },
          "name": { "type": "string", "minLength": 2 },
          "priority": { "enum": ["P0", "P1", "P2"] },
          "type": { "enum": ["功能", "边界", "异常", "性能"], "description": "边界/异常合计 ≥1（跨字段校验）" },
          "acceptance_refs": {
            "type": "array",
            "minItems": 1,
            "description": "关联验收点 M-ID；与 --criteria 冻结集合对账（跨字段校验）",
            "items": { "type": "string", "pattern": "^M-?[0-9]{2}-F[0-9]{2}-A[0-9]{2}$" }
          },
          "precondition": { "type": "string", "minLength": 2, "description": "前置条件（跨字段校验必填）" },
          "steps": {
            "type": "array",
            "minItems": 1,
            "description": "测试步骤（跨字段校验 ≥1）",
            "items": {
              "type": "object",
              "required": ["action", "expected"],
              "additionalProperties": false,
              "properties": {
                "action": { "type": "string", "minLength": 2 },
                "expected": { "type": "string", "minLength": 2 }
              }
            }
          },
          "data": {
            "type": "array",
            "description": "测试数据",
            "items": {
              "type": "object",
              "required": ["field", "value", "source"],
              "additionalProperties": false,
              "properties": {
                "field": { "type": "string", "minLength": 1 },
                "value": { "type": "string", "minLength": 1 },
                "source": { "type": "string", "minLength": 1, "description": "手动输入/预置数据/seed" }
              }
            }
          },
          "result": {
            "type": "object",
            "required": ["executed", "status"],
            "additionalProperties": false,
            "properties": {
              "executed": { "type": "boolean" },
              "date": { "type": "string" },
              "executor": { "type": "string" },
              "status": { "enum": ["PASS", "FAIL", "BLOCKED"] },
              "defect": { "type": "string", "description": "关联缺陷编号" }
            }
          }
        }
      }
    },
    "defects": {
      "type": "array",
      "description": "缺陷汇总",
      "items": {
        "type": "object",
        "required": ["id", "case_id", "description", "severity", "status", "fix_version"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "case_id": { "type": "string", "minLength": 1, "description": "必须指向真实用例（跨字段校验）" },
          "description": { "type": "string", "minLength": 4 },
          "severity": { "enum": ["P0", "P1", "P2"] },
          "status": { "type": "string", "minLength": 2 },
          "fix_version": { "type": "string", "minLength": 1 }
        }
      }
    },
    "signoffs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "name", "date"],
        "additionalProperties": false,
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "date": { "type": "string", "minLength": 1 }
        }
      }
    },
    "zero_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "reason"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
