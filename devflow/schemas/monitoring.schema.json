{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "devflow/schemas/monitoring.schema.json",
  "title": "devflow P8 监控配置结构化产物（monitoring.json）",
  "description": "P8 监控配置的机器可读业务产物层（监控三件套齐全：Prometheus 端点/日志查询证据/告警规则与验证）。渲染器派生 P8 Gate 机器可读证据行（METRICS_ENDPOINT/LOG_QUERY/LOG_QUERY_EVIDENCE/ALERT_RULE/ALERT_TESTED=PASS/ALERT_TEST_OUTPUT——artifact_gate.sh P8 机械解析格式逐字段兼容）；校验器与 Gate 同口径：证据文件真实存在、日志证据 ≥2 行、告警规则含 alert:/expr:、告警测试输出含三要素。",
  "type": "object",
  "x-zeroable": ["dashboards"],
  "required": ["feature", "generated_at", "template", "feature_name", "date", "configurer", "machine", "metrics", "dashboards", "alerts", "log_standards", "checklist", "signoffs", "zero_results"],
  "additionalProperties": false,
  "properties": {
    "feature": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 },
    "template": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "const": "监控配置-模板" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "feature_name": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "minLength": 1 },
    "configurer": { "type": "string", "minLength": 1 },
    "machine": {
      "type": "object",
      "description": "P8 Gate 机器可读证据（证据三件全部实质化）",
      "required": ["metrics_endpoint", "log_query", "log_query_evidence", "alert_rule", "alert_tested", "alert_test_output"],
      "additionalProperties": false,
      "properties": {
        "metrics_endpoint": { "type": "string", "pattern": "^https?://\\S+$", "description": "必须返回 Prometheus 内容（link-local/metadata 段被拒绝）" },
        "log_query": { "type": "string", "minLength": 1, "description": "已保存查询或大盘链接" },
        "log_query_evidence": { "type": "string", "minLength": 1, "description": "含真实查询结果且 ≥2 行的文件（跨字段校验）" },
        "alert_rule": { "type": "string", "minLength": 1, "description": "含 alert: 与 expr: 的规则文件（跨字段校验内容）" },
        "alert_tested": { "enum": ["PASS"], "description": "告警未验证 = 三件套不齐全（跨字段校验必须 PASS）" },
        "alert_test_output": { "type": "string", "minLength": 1, "description": "≥20B 且含 ALERT_TRIGGERED/NOTIFICATION_CONFIRMED/RECOVERY_RECORDED 三要素（跨字段校验）" }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "description": "Prometheus 业务指标",
      "items": {
        "type": "object",
        "required": ["name", "type", "desc", "unit"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_:]*$" },
          "type": { "enum": ["Counter", "Gauge", "Histogram", "Summary"] },
          "desc": { "type": "string", "minLength": 2 },
          "unit": { "type": "string", "minLength": 1 }
        }
      }
    },
    "dashboards": {
      "type": "array",
      "description": "Grafana 大盘面板",
      "items": {
        "type": "object",
        "required": ["panel", "source", "refresh"],
        "additionalProperties": false,
        "properties": {
          "panel": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "refresh": { "type": "string", "minLength": 1 }
        }
      }
    },
    "alerts": {
      "type": "array",
      "minItems": 1,
      "description": "告警规则",
      "items": {
        "type": "object",
        "required": ["name", "level", "condition", "duration", "notify"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "level": { "enum": ["P0", "P1"] },
          "condition": { "type": "string", "minLength": 2 },
          "duration": { "type": "string", "minLength": 1 },
          "notify": { "type": "string", "minLength": 1 }
        }
      }
    },
    "log_standards": {
      "type": "array",
      "minItems": 1,
      "description": "日志规范",
      "items": {
        "type": "object",
        "required": ["scene", "level", "fields"],
        "additionalProperties": false,
        "properties": {
          "scene": { "type": "string", "minLength": 2 },
          "level": { "enum": ["INFO", "WARN", "ERROR", "DEBUG"] },
          "fields": { "type": "string", "minLength": 2, "description": "必须包含字段（traceId, userId, …）" }
        }
      }
    },
    "checklist": {
      "type": "array",
      "minItems": 1,
      "description": "验证检查清单；全部 PASS 才能签发 P8 收据（跨字段校验）",
      "items": {
        "type": "object",
        "required": ["item", "cmd", "expected", "actual", "status"],
        "additionalProperties": false,
        "properties": {
          "item": { "type": "string", "minLength": 2 },
          "cmd": { "type": "string", "minLength": 2 },
          "expected": { "type": "string", "minLength": 1 },
          "actual": { "type": "string", "minLength": 1 },
          "status": { "enum": ["PASS", "FAIL"] }
        }
      }
    },
    "signoffs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "name", "date"],
        "additionalProperties": false,
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "date": { "type": "string", "minLength": 1 }
        }
      }
    },
    "zero_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "reason"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
