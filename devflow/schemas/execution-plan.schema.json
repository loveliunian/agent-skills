{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "feature",
    "generated_at",
    "template",
    "tasks",
    "report_path"
  ],
  "properties": {
    "feature": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "template": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "acceptance_ids",
          "design_refs",
          "target",
          "action",
          "verify"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^T-[0-9]+"
          },
          "acceptance_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^M-[0-9]{2}-F[0-9]{2}-A[0-9]{2}$"
            }
          },
          "design_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": [
              "ADD",
              "MODIFY",
              "DELETE",
              "REUSE"
            ]
          },
          "invariants": {
            "type": "string"
          },
          "verify": {
            "type": "string",
            "minLength": 1
          },
          "risk": {
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "action": {
                  "const": "MODIFY"
                }
              }
            },
            "then": {
              "required": [
                "invariants"
              ]
            }
          }
        ]
      }
    },
    "slices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "slice_id",
          "task_ids"
        ],
        "properties": {
          "slice_id": {
            "type": "string"
          },
          "task_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": "string"
          },
          "components": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "report_path": {
      "type": "string",
      "minLength": 1
    }
  },
  "x-zeroable": [
    "slices"
  ],
  "x-unique": [
    "tasks[].task_id"
  ]
}