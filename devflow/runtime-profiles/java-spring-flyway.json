{
  "$schema": "../schemas/runtime-profile.schema.json",
  "profile_id": "java-spring-flyway",
  "name": "Java Spring Boot + Flyway 四方言",
  "version": "1.0.0",
  "description": "Java 11/17+ / Spring Boot 2.x/3.x / Flyway 多方言（h2, postgresql, oracle, kingbase）+ 菜单权限 seed + JaCoCo 覆盖率",
  
  "backend": {
    "language": "java",
    "framework": "spring-boot",
    "build_adapter": {
      "command": "mvn -q compile",
      "working_dir": "backend/{service}",
      "success_exit_code": 0,
      "error_patterns": [
        "\\[ERROR\\]",
        "BUILD FAILURE"
      ]
    },
    "test_adapter": {
      "command": "mvn test",
      "working_dir": "backend/{service}",
      "success_exit_code": 0,
      "coverage_report_path": "target/site/jacoco/index.html"
    },
    "lint_adapter": {
      "command": "mvn checkstyle:check",
      "working_dir": "backend/{service}",
      "optional": true
    },
    "coverage_adapter": {
      "command": "mvn jacoco:report",
      "working_dir": "backend/{service}",
      "threshold": {
        "core_business": 0.80,
        "total": 0.70
      },
      "report_parser": {
        "type": "jacoco-html",
        "path": "target/site/jacoco/index.html",
        "xpath_coverage": "//tfoot/tr/td[@class='ctr2']"
      }
    }
  },

  "authorization": {
    "required": true,
    "verification_adapter": {
      "command": "bash scripts/verify-authorization.sh",
      "checks": [
        {
          "name": "controller_annotations",
          "description": "所有 Controller 必须有 @PreAuthorize",
          "pattern": "@PreAuthorize\\(",
          "target_paths": ["backend/*/src/main/java/**/*Controller.java"]
        },
        {
          "name": "permission_matrix_alignment",
          "description": "权限码与权限矩阵对账",
          "command": "bash scripts/check-perm-matrix.sh"
        }
      ]
    }
  },

  "persistence": {
    "required": true,
    "migration_system": "flyway",
    "dialects": ["h2", "postgresql", "oracle", "kingbase"],
    "migration_adapter": {
      "command": "mvn flyway:migrate -Dflyway.configFiles=flyway-{dialect}.conf",
      "working_dir": "backend/{service}",
      "paths": {
        "h2": "src/main/resources/db/migration/h2",
        "postgresql": "src/main/resources/db/migration/postgresql",
        "oracle": "src/main/resources/db/migration/oracle",
        "kingbase": "src/main/resources/db/migration/kingbase"
      },
      "validation": {
        "sync_check": true,
        "version_pattern": "^V\\d+__[a-zA-Z0-9_]+\\.sql$"
      }
    },
    "seed_adapter": {
      "command": "bash scripts/seed-{dialect}.sh",
      "required_tables": [
        "sys_menu",
        "sys_menu_operation",
        "sys_permission_group",
        "sys_user_effective_perm"
      ]
    }
  },

  "client": {
    "scope_options": ["pc-web", "mini-program", "app", "not-applicable"],
    "pc-web": {
      "framework": "vue3",
      "build_adapter": {
        "command": "npm run build",
        "working_dir": "frontend",
        "type_check": "npm run type-check"
      },
      "journey_adapter": {
        "command": "npm run test:e2e",
        "working_dir": "frontend",
        "browser": "chromium",
        "report_path": "test-results/e2e-report.html"
      },
      "route_registration_check": {
        "command": "bash scripts/check-route-registration.sh",
        "pattern": "path:\\s*['\"]/.+['\"]"
      }
    },
    "mini-program": {
      "framework": "uni-app",
      "build_adapter": {
        "command": "npm run build:mp-weixin",
        "working_dir": "frontend-mp"
      },
      "journey_adapter": {
        "command": "npm run test:mp",
        "working_dir": "frontend-mp",
        "simulator": "wechat-devtools-cli"
      }
    },
    "app": {
      "framework": "uni-app",
      "build_adapter": {
        "command": "npm run build:app",
        "working_dir": "frontend-app"
      },
      "journey_adapter": {
        "command": "npm run test:app",
        "working_dir": "frontend-app",
        "emulator": "android/ios"
      }
    }
  },

  "security": {
    "adapter": {
      "command": "bash checks/security-scan.sh",
      "checks": [
        "sql-injection",
        "xss-vulnerability",
        "auth-bypass",
        "sensitive-data-exposure",
        "dependency-vulnerabilities"
      ],
      "blockers": ["P0"],
      "report_path": "docs/review/{feature}-security-audit-report.md"
    }
  },

  "performance": {
    "adapter": {
      "command": "bash checks/performance-scan.sh",
      "thresholds": {
        "api_p95_ms": 200,
        "api_p99_ms": 500,
        "db_query_p95_ms": 50
      },
      "report_path": "docs/review/{feature}-performance-audit-report.md"
    }
  },

  "deployment": {
    "health_check": {
      "endpoint": "/actuator/health",
      "expected_status": 200,
      "timeout_seconds": 10
    },
    "artifacts": [
      "backend/{service}/target/{service}.jar",
      "frontend/dist/"
    ],
    "environments": ["dev", "staging", "prod"]
  },

  "monitoring": {
    "required_metrics": [
      "api_qps",
      "api_latency_p95",
      "error_rate",
      "db_connection_pool"
    ],
    "log_levels": {
      "dev": "DEBUG",
      "staging": "INFO",
      "prod": "WARN"
    }
  },

  "coding_standards": {
    "mandatory_docs": [
      "concepts/Java开发手册_黄山版.md"
    ],
    "conventions": {
      "naming": "camelCase for Java, kebab-case for SQL",
      "comment_threshold": "复杂业务逻辑必须注释",
      "mapper_rule": "一个 Entity 对应一个 Mapper 接口"
    }
  },

  "gate_bindings": {
    "P3-build": "backend.build_adapter",
    "P3-completion": [
      "backend.test_adapter",
      "authorization.verification_adapter"
    ],
    "P3c-security": "security.adapter",
    "P3d-performance": "performance.adapter",
    "P5-migration": "persistence.migration_adapter",
    "P6-coverage": "backend.coverage_adapter",
    "P6-journey": "client.{scope}.journey_adapter",
    "P7-deploy": "deployment.health_check"
  },

  "compatibility": {
    "java_version": "11+",
    "spring_boot_version": "2.x, 3.x",
    "flyway_version": "7.x+",
    "maven_version": "3.6+"
  }
}
