{
  "$schema": "../schemas/runtime-profile.schema.json",
  "profile_id": "java-spring-flyway",
  "name": "Java Spring Boot + Flyway 四方言",
  "version": "1.0.0",
  "description": "Java 11/17+ / Spring Boot 2.x/3.x / Flyway 多方言（h2, postgresql, oracle, kingbase）+ 菜单权限 seed + JaCoCo 覆盖率",
  "backend": {
    "language": "java",
    "framework": "spring-boot",
    "build_adapter": {
      "working_dir": "backend/{service}",
      "success_exit_code": 0,
      "error_patterns": [
        "\\[ERROR\\]",
        "BUILD FAILURE"
      ],
      "executable": "mvn",
      "args": [
        "-q",
        "compile"
      ]
    },
    "test_adapter": {
      "working_dir": "backend/{service}",
      "success_exit_code": 0,
      "coverage_report_path": "target/site/jacoco/index.html",
      "executable": "mvn",
      "args": [
        "test"
      ]
    },
    "lint_adapter": {
      "working_dir": "backend/{service}",
      "optional": true,
      "executable": "mvn",
      "args": [
        "checkstyle:check"
      ]
    },
    "coverage_adapter": {
      "working_dir": "backend/{service}",
      "threshold": {
        "core_business": 0.8,
        "total": 0.7
      },
      "report_parser": {
        "type": "jacoco-html",
        "path": "target/site/jacoco/index.html",
        "xpath_coverage": "//tfoot/tr/td[@class='ctr2']"
      },
      "executable": "mvn",
      "args": [
        "jacoco:report"
      ]
    }
  },
  "authorization": {
    "required": true,
    "verification_adapter": {
      "checks": [
        {
          "name": "controller_annotations",
          "description": "所有 Controller 必须有 @PreAuthorize",
          "pattern": "@PreAuthorize\\(",
          "target_paths": [
            "backend/*/src/main/java/**/*Controller.java"
          ]
        },
        {
          "name": "permission_matrix_alignment",
          "description": "权限码与权限矩阵对账",
          "executable": "bash",
          "args": [
            "scripts/check-perm-matrix.sh"
          ]
        }
      ],
      "executable": "bash",
      "args": [
        "scripts/verify-authorization.sh"
      ]
    }
  },
  "persistence": {
    "required": true,
    "migration_system": "flyway",
    "dialects": [
      "h2",
      "postgresql",
      "oracle",
      "kingbase"
    ],
    "migration_adapter": {
      "working_dir": "backend/{service}",
      "paths": {
        "h2": "src/main/resources/db/migration/h2",
        "postgresql": "src/main/resources/db/migration/postgresql",
        "oracle": "src/main/resources/db/migration/oracle",
        "kingbase": "src/main/resources/db/migration/kingbase"
      },
      "validation": {
        "sync_check": true,
        "version_pattern": "^V\\d+__[a-zA-Z0-9_]+\\.sql$"
      },
      "executable": "mvn",
      "args": [
        "flyway:migrate",
        "-Dflyway.configFiles=flyway-{dialect}.conf"
      ]
    },
    "seed_adapter": {
      "required_tables": [
        "sys_menu",
        "sys_menu_operation",
        "sys_permission_group",
        "sys_user_effective_perm"
      ],
      "executable": "bash",
      "args": [
        "scripts/seed-{dialect}.sh"
      ]
    }
  },
  "client": {
    "scope_options": [
      "pc-web",
      "mini-program",
      "app",
      "not-applicable"
    ],
    "pc-web": {
      "framework": "vue3",
      "build_adapter": {
        "working_dir": "frontend",
        "type_check": "npm run type-check",
        "executable": "npm",
        "args": [
          "run",
          "build"
        ]
      },
      "journey_adapter": {
        "working_dir": "frontend",
        "browser": "chromium",
        "report_path": "test-results/e2e-report.html",
        "executable": "npm",
        "args": [
          "run",
          "test:e2e"
        ]
      },
      "route_registration_check": {
        "pattern": "path:\\s*['\"]/.+['\"]",
        "executable": "bash",
        "args": [
          "scripts/check-route-registration.sh"
        ]
      }
    },
    "mini-program": {
      "framework": "uni-app",
      "build_adapter": {
        "working_dir": "frontend-mp",
        "executable": "npm",
        "args": [
          "run",
          "build:mp-weixin"
        ]
      },
      "journey_adapter": {
        "working_dir": "frontend-mp",
        "simulator": "wechat-devtools-cli",
        "executable": "npm",
        "args": [
          "run",
          "test:mp"
        ]
      }
    },
    "app": {
      "framework": "uni-app",
      "build_adapter": {
        "working_dir": "frontend-app",
        "executable": "npm",
        "args": [
          "run",
          "build:app"
        ]
      },
      "journey_adapter": {
        "working_dir": "frontend-app",
        "emulator": "android/ios",
        "executable": "npm",
        "args": [
          "run",
          "test:app"
        ]
      }
    }
  },
  "security": {
    "adapter": {
      "checks": [
        "sql-injection",
        "xss-vulnerability",
        "auth-bypass",
        "sensitive-data-exposure",
        "dependency-vulnerabilities"
      ],
      "blockers": [
        "P0"
      ],
      "report_path": "docs/review/{feature}-security-audit-report.md",
      "executable": "bash",
      "args": [
        "checks/security-scan.sh"
      ]
    }
  },
  "performance": {
    "adapter": {
      "thresholds": {
        "api_p95_ms": 200,
        "api_p99_ms": 500,
        "db_query_p95_ms": 50
      },
      "report_path": "docs/review/{feature}-performance-audit-report.md",
      "executable": "bash",
      "args": [
        "checks/performance-scan.sh"
      ]
    }
  },
  "deployment": {
    "health_check": {
      "endpoint": "/actuator/health",
      "expected_status": 200,
      "timeout_seconds": 10
    },
    "artifacts": [
      "backend/{service}/target/{service}.jar",
      "frontend/dist/"
    ],
    "environments": [
      "dev",
      "staging",
      "prod"
    ]
  },
  "monitoring": {
    "required_metrics": [
      "api_qps",
      "api_latency_p95",
      "error_rate",
      "db_connection_pool"
    ],
    "log_levels": {
      "dev": "DEBUG",
      "staging": "INFO",
      "prod": "WARN"
    }
  },
  "coding_standards": {
    "mandatory_docs": [
      "concepts/Java开发手册_黄山版.md"
    ],
    "conventions": {
      "naming": "camelCase for Java, kebab-case for SQL",
      "comment_threshold": "复杂业务逻辑必须注释",
      "mapper_rule": "一个 Entity 对应一个 Mapper 接口"
    }
  },
  "gate_bindings": {
    "P3-build": "backend.build_adapter",
    "P3-completion": [
      "backend.test_adapter",
      "authorization.verification_adapter"
    ],
    "P3c-security": "security.adapter",
    "P3d-performance": "performance.adapter",
    "P5-migration": "persistence.migration_adapter",
    "P6-coverage": "backend.coverage_adapter",
    "P6-journey": "client.{scope}.journey_adapter",
    "P7-deploy": "deployment.health_check"
  },
  "compatibility": {
    "java_version": "11+",
    "spring_boot_version": "2.x, 3.x",
    "flyway_version": "7.x+",
    "maven_version": "3.6+"
  }
}