# =====================================================================
# env.example —— flow-test-contract 运行态凭据/env 模板（v1.3.3 去 .env 化）
# 用法：cp 本文件 $RUNTIME_DIR/env 后按注释填真值
#       （skill 自持布局缺省 ~/.agents/skills/flow-test-contract/runtime/<项目键>/env；
#        项目部署布局 .flow-test-contract/runtime/env）；该目录绝不入库/同步
# 优先级：进程环境变量 > 本文件（setdefault）；密码缺键时仅在 FLOWTEST_ALLOW_DEFAULT_PWD=1 下以 FLOWTEST_DEFAULT_PWD 兜底
# 校验：python3 $SKILL/scripts/legacy-config-check.py --systems-dir $RUNTIME_DIR/systems/api
# =====================================================================

# ────── 0) 统一默认密码兜底（推荐：一条即可覆盖全部账号） ──────
# 设定后：actorMap 密码键缺失 → 回退此值；用户名键缺失 → 回退 actor 本名
# FLOWTEST_ALLOW_DEFAULT_PWD="1"   # 明确授权统一默认密码（生产环境慎用）
# FLOWTEST_DEFAULT_PWD=""

# ────── 1) 正式 PASS 必需：结论须绑定"什么版本对什么版本"（缺失 → conclude BLOCKED） ──────
SOURCE_VERSION=""        # 老系统版本标识（如 oracle-2026-09-04 基线）
TARGET_VERSION=""        # 新引擎发布版本/发布包号（gate 证据 target_env 也校验与此一致）
FLOW_VERSION=""          # 流程版本（如 WFA_RY_HZ_0162 v5 / BPMN 版本号）

# ────── 2) launch 元素 ID（launch-first 必需，按流程命名；F12 Elements 抄 <option value>） ──────
# 格式：LAUNCH_ELEMENT_ID_<FLOW_CODE 大写>；缺 → api-capture 拒跑（不猜）
# LAUNCH_ELEMENT_ID_WFA_RY_HZ_0162=

# ────── 3) 老系统（legacy）账号凭据——只写 env 引用，值不入库 ──────
# 格式：LEGACY_<账号大写>_USER / LEGACY_<账号大写>_PWD；与 systems/api/legacy.yaml actorMap 对齐
# （个别账号密码 ≠ 统一默认密码时才需单独列出，其余交给 FLOWTEST_DEFAULT_PWD）
# LEGACY_ADMIN_USER=""
# LEGACY_ADMIN_PWD=""

# ────── 4) 新系统（current）账号凭据——同上，与 systems/api/current.yaml actorMap 对齐 ──────
# CURRENT_ADMIN_USER=""
# CURRENT_ADMIN_PWD=""

# ────── 5) 可调参数（有合理默认，一般不动） ──────
# api 采集 HTTP 超时（秒，默认 15）：老系统/跨网段慢响应实测不够时调大
# FLOWTEST_HTTP_TIMEOUT=15
# gate 证据最大时效（秒，默认 86400=24h）：generated_at 超窗即过期
# GATE_EVIDENCE_MAX_AGE_SEC=86400
# 执行后端：api（默认，内置 HTTP 采集）/ browser（浏览器通道）/ cli（显式 FLOWTEST_CLI 兼容）/ none
# FLOWTEST_RUNNER=api
# 运行态根整体覆盖（缺省 $SKILL/runtime/<项目键>/）
# FLOWTEST_RUNTIME_DIR=
# systems api 配置目录覆盖（缺省 $SKILL/runtime/<项目键>/systems/api；<项目键>=名称-hash8）
# FLOWTEST_SYSTEMS_API_DIR=
# 项目根覆盖（skill 直跑且 cwd 不在项目内时）
# FLOWTEST_PROJECT_ROOT=
