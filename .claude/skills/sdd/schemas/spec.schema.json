{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "spec",
  "type": "object",
  "required": [
    "id",
    "name",
    "boundary",
    "deps",
    "status",
    "rules",
    "tasks",
    "acceptances"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^F\\d{3}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "boundary": {
      "type": "string",
      "minLength": 5
    },
    "deps": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^F\\d{3}$"
      }
    },
    "status": {
      "enum": [
        "草案",
        "已确认",
        "实现中",
        "已交付"
      ]
    },
    "approvedBy": {
      "type": "string",
      "description": "spec 确认人;status=已确认 及以后必填"
    },
    "approvedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "spec 确认 确认日期"
    },
    "source": {
      "type": "string",
      "description": "详设章节,如 §3.2"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "qRefs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R\\d+$"
          },
          "text": {
            "type": "string",
            "minLength": 8
          },
          "qRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^Q\\d{3}$"
            }
          },
          "sourceRules": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^C\\d{2,3}-R\\d{2,}$"
            },
            "description": "追溯至 _work/extract-*.json 的规则编号。rule-ledger 中标 assigned 到本 feature 的每条规则,必须至少被一条 spec 规则的 sourceRules 引用,否则视为分派后丢失"
          }
        },
        "additionalProperties": false
      }
    },
    "apis": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "method",
          "path",
          "purpose",
          "ruleRefs"
        ],
        "properties": {
          "method": {
            "enum": [
              "GET",
              "POST",
              "PUT",
              "DELETE",
              "PATCH"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "purpose": {
            "type": "string",
            "minLength": 2
          },
          "ruleRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^R\\d+$"
            }
          },
          "noRequest": {
            "type": "boolean",
            "description": "确无入参时标 true,否则必须列 requestFields 或挂 openapi.yaml"
          },
          "requestFields": {
            "type": "array",
            "description": "入参字段清单(每条必须有 type 与 example);契约外置到 openapi.yaml 时可留空",
            "items": {
              "type": "object",
              "required": [
                "name",
                "type"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "required": {
                  "type": "boolean"
                },
                "example": {},
                "validation": {
                  "type": "string",
                  "description": "校验规则,如 长度 1~32"
                }
              },
              "additionalProperties": false
            }
          },
          "responseFields": {
            "type": "array",
            "description": "出参字段清单(每条必须有 type 与 example)",
            "items": {
              "type": "object",
              "required": [
                "name",
                "type"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "example": {},
                "note": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "errorCodes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "code",
                "message",
                "when"
              ],
              "properties": {
                "code": {
                  "type": [
                    "string",
                    "integer"
                  ]
                },
                "message": {
                  "type": "string",
                  "minLength": 1
                },
                "when": {
                  "type": "string",
                  "minLength": 2,
                  "description": "触发条件"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "desc"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^T\\d+$"
          },
          "desc": {
            "type": "string",
            "minLength": 4
          }
        },
        "additionalProperties": false
      }
    },
    "acceptances": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "ref",
          "steps",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^A\\d+$"
          },
          "ref": {
            "type": "string",
            "pattern": "^(R\\d+|API:.+)$"
          },
          "steps": {
            "type": "string",
            "minLength": 8
          },
          "expected": {
            "type": "string",
            "minLength": 2
          },
          "covers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "本条用例对应验证的详设验收点 ID(取自抽取件 acceptances[].acceptanceId);详设无验收章节时省略"
          }
        },
        "additionalProperties": false
      }
    },
    "coversAcceptances": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "本 feature 覆盖的详设验收点全集(与 acceptances[].covers 的并集一致)。脚本会核对:凡分派到本 feature 的规则所属的验收点,必须出现在这里,否则 开工放行 红"
    },
    "openApi": {
      "type": [
        "string",
        "null"
      ],
      "description": "openapi.yaml 文件名,无则 null"
    },
    "tables": {
      "type": "array",
      "description": "md §3 数据模型的 json 侧登记;有数据表变更时必填",
      "items": {
        "type": "object",
        "required": [
          "name",
          "purpose"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 2
          },
          "change": {
            "enum": [
              "new",
              "alter"
            ],
            "description": "new=新建表,alter=改既有表"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "R-J 字段口径一致性:抄录本 spec 认定的字段定义串(列名 类型(长度) 约束 [Q编号] -- 备注);与详设抽取件 twin 有差异(缺列/新增/改长度)的字段必须以 [Q编号] 标注登记裁决"
          },
          "indexes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "索引/唯一约束登记(自详设抽取件 tables[].indexes 抄录,如 uk_xxx(a,b))。供「删了重插」对账 WARN 扫描唯一索引×逻辑删除互斥(先例 Q018)"
          }
        },
        "additionalProperties": false
      }
    },
    "nfrs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "dimension",
          "requirement"
        ],
        "properties": {
          "dimension": {
            "enum": [
              "performance",
              "security",
              "idempotency",
              "compatibility",
              "quality",
              "capacity",
              "reliability",
              "observability",
              "operability",
              "maintainability",
              "scalability",
              "compliance",
              "other"
            ],
            "description": "枚举值与 chunk-extract.schema.json 保持同步;other 时必须同时填 subDimension"
          },
          "subDimension": {
            "type": "string"
          },
          "requirement": {
            "type": "string",
            "minLength": 2
          },
          "target": {
            "type": "string",
            "description": "可度量目标值,如 P95<500ms / 覆盖率≥80%"
          },
          "source": {
            "type": "string",
            "description": "详设出处,如 §6.1;无则填 新增 并出现在解释性决定清单"
          }
        },
        "additionalProperties": false
      }
    },
    "interpretiveDecisions": {
      "type": "array",
      "description": "解释性决定清单,每条一个推断点",
      "items": {
        "type": "object",
        "required": [
          "location",
          "understanding",
          "basis"
        ],
        "properties": {
          "location": {
            "type": "string"
          },
          "understanding": {
            "type": "string"
          },
          "basis": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}