            "is_builtin boolean NOT NULL DEFAULT false -- 内置要素不可删除",
            "recycled_at timestamp NULL -- 进入回收站时间(逻辑删除标记)",
            "created_by/at, updated_by/at -- 审计,操作人固定 admin"
          ],
          "indexes": [
            "uk_element_code(element_code) UNIQUE",
            "idx_element_type_status(element_type, status)"
