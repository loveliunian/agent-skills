          "fields": [
            "id bigint PK -- 要素 ID",
            "element_type varchar(20) NOT NULL -- METADATA/PARAMETER/FORM/PROCESS",
            "element_code varchar(50) NOT NULL, UNIQUE -- 编码,由全局配置规则生成",
            "element_name varchar(100) NOT NULL -- 命名规则生成的展示名",
